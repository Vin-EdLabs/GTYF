# Copy to .env and fill in. Never commit .env.

# --- Core -------------------------------------------------------------------
# NODE_ENV is NOT set here: Vite reads this file and would build React in development mode.
# The server defaults to development; PM2 sets NODE_ENV=production on the VPS.
PORT=4000
# Public origin, no trailing slash. Used for CORS, Paystack callback and emails.
SITE_URL=http://localhost:5173
# Same origin, exposed to the client build for canonical/Open Graph URLs.
# MUST be the real https:// domain for production builds or share previews break.
VITE_SITE_URL=http://localhost:5173

# --- Database ---------------------------------------------------------------
# Local: `npm run db:up` starts Postgres from docker-compose.yml with these credentials.
DATABASE_URL=postgres://gtyf:gtyf@localhost:5432/gtyf

# --- Auth -------------------------------------------------------------------
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=

# First super admin, created by `npm run db:seed`. Remove both lines after seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# --- Paystack ---------------------------------------------------------------
# Use sk_test_/pk_test_ keys until launch. Never commit real keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Paystack's local fee (%), used for "cover the fee". CONFIRM against GTYF's Paystack pricing.
PAYSTACK_FEE_PERCENT=1.95
# Largest single online gift, in cedis.
DONATION_MAX_CEDIS=50000

# --- Email ------------------------------------------------------------------
# Leave SMTP_HOST empty in development: emails are written to server/.mail-outbox/ instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Guide The Youth Foundation <no-reply@example.org>"
ADMIN_ALERT_EMAIL=

# --- Uploads (Phase 5) ------------------------------------------------------
UPLOAD_DIR=./uploads
