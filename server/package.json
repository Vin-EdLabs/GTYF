{
  "name": "@gtyf/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "test:donations": "tsx --env-file-if-exists=../.env scripts/donation-smoke.ts",
    "brand": "tsx scripts/brand-assets.ts",
    "test:admin": "tsx --env-file-if-exists=../.env scripts/admin-smoke.ts",
    "test:content": "tsx --env-file-if-exists=../.env scripts/content-smoke.ts",
    "demo-photos:fetch": "tsx scripts/fetch-demo-photos.ts",
    "db:migrate:prod": "node --env-file-if-exists=../.env dist/db/migrate.js",
    "db:seed:prod": "node --env-file-if-exists=../.env dist/db/seed.js"
  },
  "dependencies": {
    "@gtyf/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
