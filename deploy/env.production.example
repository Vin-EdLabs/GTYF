# Production settings for guidetheyouth.scholarnerve.com
# deploy/setup-server.sh copies this to /srv/gtyf/.env and fills in the generated
# values (database password, JWT secret, first admin password). You add the rest.
#
# NEVER put NODE_ENV here: PM2 sets it (Vite reads this file and would build in dev mode).

PORT=4310
SITE_URL=https://guidetheyouth.scholarnerve.com
VITE_SITE_URL=https://guidetheyouth.scholarnerve.com

# PostgreSQL on this server (created by setup-server.sh).
DATABASE_URL=__DATABASE_URL__

# Random 48-byte secret (generated). Changing it signs every admin out.
JWT_SECRET=__JWT_SECRET__

# First super admin, created on the first deploy. Change the password after signing in,
# then delete these three lines.
SEED_ADMIN_NAME=GTYF Admin
SEED_ADMIN_EMAIL=__ADMIN_EMAIL__
SEED_ADMIN_PASSWORD=__ADMIN_PASSWORD__

# --- Paystack --------------------------------------------------------------
# Start with TEST keys (sk_test_/pk_test_) to check everything, then switch to LIVE.
# Webhook URL for the Paystack dashboard:
#   https://guidetheyouth.scholarnerve.com/api/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_FEE_PERCENT=1.95
DONATION_MAX_CEDIS=50000

# --- Email (receipts, alerts) ----------------------------------------------
# Any SMTP provider works (e.g. Zoho Mail, Google Workspace, Brevo, Mailgun, Resend SMTP).
# Until this is set, emails are saved on the server in MAIL_OUTBOX_DIR instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Guide The Youth Foundation <no-reply@scholarnerve.com>"
# Who gets "new donation" and "new volunteer/message" alerts.
ADMIN_ALERT_EMAIL=

# --- Files -----------------------------------------------------------------
UPLOAD_DIR=/var/lib/gtyf/uploads
MAIL_OUTBOX_DIR=/var/lib/gtyf/mail-outbox
